{
  "name": "hera-app",
  "private": true,
  "version": "1.0.0",
  "description": "Hera App web + Android wrapper via Capacitor",
  "scripts": {
    "serve": "python3 -m http.server 8080",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "sh -c '[ -f android/gradlew ] || { rm -rf android && npx cap add android; }; npx cap sync android; cd android && ./gradlew assembleDebug'",
    "android:prepare-release": "node scripts/prepare-android-release.js",
    "android:aab": "node scripts/prepare-android-release.js --bundle"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0"
  },
  "dependencies": {
    "@capacitor/core": "^7.2.0",
    "@capacitor/android": "^7.2.0"
  }
}
